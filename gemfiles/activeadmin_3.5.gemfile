# frozen_string_literal: true

source "https://rubygems.org"

gemspec path: ".."

# ActiveAdmin 3.5 line: classic Sprockets + Sassc asset pipeline.
gem "activeadmin", "~> 3.5.0"
gem "rails",       "~> 7.2.0"

# openid_connect 1.x line (httpclient-based, no faraday dep). Pinning the
# 0.6.x series here keeps CI exercising the pre-faraday strategy path.
gem "omniauth_openid_connect", "~> 0.6.0"

gem "sprockets-rails", ">= 3.4"
gem "sassc-rails",     ">= 2.1"

# json 3.0 dropped the `quirks_mode` keyword that ActiveSupport::JSON
# still passes to JSON.parse/JSON.generate (activesupport 7.2 and 8.0,
# lib/active_support/json/{decoding,encoding}.rb). CI has no lockfile, so
# it picks up json 3.x and every request spec dies with
# `ArgumentError: unknown keyword: quirks_mode`. Drop this once Rails
# ships a version that no longer passes it.
gem "json", "< 3"
